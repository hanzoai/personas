{
  "name": "@hanzo/personas",
  "version": "1.1.0",
  "description": "Hanzo's core agent team (team/*.md), the people who lead it (people/*.md), the persona schema, the OCEAN test, and a roster of 1,044 figures",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./team.js": {
      "types": "./dist/team.d.ts",
      "default": "./dist/team.js"
    },
    "./persona.js": {
      "types": "./dist/persona.d.ts",
      "default": "./dist/persona.js"
    },
    "./ocean.js": {
      "types": "./dist/ocean.d.ts",
      "default": "./dist/ocean.js"
    },
    "./compile.js": {
      "types": "./dist/compile.d.ts",
      "default": "./dist/compile.js"
    },
    "./schema/*": "./schema/*",
    "./team/*": "./team/*",
    "./people/*": "./people/*",
    "./personas/*": "./personas/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p .",
    "test": "node --test src/*.test.ts && go test ./...",
    "prepack": "npm run build"
  },
  "files": [
    "dist",
    "team/*.md",
    "people/*.md",
    "schema/*.json",
    "assets",
    "personas/**/*.json",
    "personas/**/*.md",
    "README.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "keywords": [
    "personality",
    "ocean",
    "big-five",
    "neo-pi-r",
    "hexaco",
    "psychology",
    "ai",
    "personas",
    "agents"
  ],
  "author": "Hanzo AI",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/personas.git"
  },
  "types": "dist/index.d.ts",
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^24.0.0"
  }
}
