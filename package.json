{
  "name": "@hanzo/personas",
  "version": "1.0.4",
  "description": "Hanzo's core agent team (team/*.md) and a roster of 1,044 figures with hand-written PERSONA.md definitions",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./team.js": {
      "types": "./team.d.ts",
      "default": "./team.js"
    },
    "./team/*": "./team/*",
    "./personas/*": "./personas/*"
  },
  "scripts": {
    "test": "node test.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "team.js",
    "team.d.ts",
    "team/*.md",
    "personas/**/*.json",
    "personas/**/*.md",
    "README.md"
  ],
  "keywords": [
    "personality",
    "ocean",
    "big-five",
    "neo-pi-r",
    "hexaco",
    "psychology",
    "ai",
    "personas",
    "agents"
  ],
  "author": "Hanzo AI",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanzoai/personas.git"
  },
  "types": "index.d.ts"
}
